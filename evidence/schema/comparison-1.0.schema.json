{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "route",
    "semantics_version",
    "scenario",
    "stages",
    "comparison",
    "environment",
    "provenance"
  ],
  "properties": {
    "format": {
      "const": "protocol-sentinel-comparison"
    },
    "schema_version": {
      "const": "1.0"
    },
    "route": {
      "type": "string"
    },
    "semantics_version": {
      "type": "string"
    },
    "scenario": {
      "type": "object"
    },
    "stages": {
      "type": "object"
    },
    "comparison": {
      "type": "object"
    },
    "environment": {
      "$ref": "#/$defs/environment"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Protocol Sentinel Comparison Evidence 1.0",
  "description": "Strict structural schema. Semantic equivalence and execution provenance require separate checks.",
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "bytes": {
      "type": "string",
      "pattern": "^0x(?:[0-9a-fA-F]{2})*$"
    },
    "uint256": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 78,
      "description": "Canonical decimal uint256; exact numeric upper bound checked by the parser."
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "directSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "target",
        "candidate",
        "expectedRevert",
        "policy"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/address"
        },
        "target": {
          "$ref": "#/$defs/address"
        },
        "candidate": {
          "$ref": "#/$defs/address"
        },
        "expectedRevert": {
          "$ref": "#/$defs/bytes"
        },
        "policy": {
          "enum": [
            "NO_IMPLEMENTATION_REPLACEMENT",
            "NO_SUCCESSFUL_UPGRADE_CALL"
          ]
        }
      }
    },
    "routedSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timelock",
        "proposer",
        "executor",
        "proxyAdmin",
        "proxy",
        "candidate",
        "predecessor",
        "salt",
        "property"
      ],
      "properties": {
        "timelock": {
          "$ref": "#/$defs/address"
        },
        "proposer": {
          "$ref": "#/$defs/address"
        },
        "executor": {
          "$ref": "#/$defs/address"
        },
        "proxyAdmin": {
          "$ref": "#/$defs/address"
        },
        "proxy": {
          "$ref": "#/$defs/address"
        },
        "candidate": {
          "$ref": "#/$defs/address"
        },
        "predecessor": {
          "$ref": "#/$defs/bytes32"
        },
        "salt": {
          "$ref": "#/$defs/bytes32"
        },
        "property": {
          "enum": [
            "READY_UPGRADE_SUCCEEDS",
            "NOT_READY_EXECUTION_REJECTED"
          ]
        }
      }
    },
    "directObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor",
        "txOrigin",
        "target",
        "success",
        "returnData",
        "observedSlot",
        "implementationBefore",
        "implementationAfter",
        "callData",
        "candidateValidAtObservation",
        "targetValidAtObservation"
      ],
      "properties": {
        "actor": {
          "$ref": "#/$defs/address"
        },
        "txOrigin": {
          "$ref": "#/$defs/address"
        },
        "target": {
          "$ref": "#/$defs/address"
        },
        "success": {
          "type": "boolean"
        },
        "returnData": {
          "$ref": "#/$defs/bytes"
        },
        "observedSlot": {
          "$ref": "#/$defs/bytes32"
        },
        "implementationBefore": {
          "$ref": "#/$defs/bytes32"
        },
        "implementationAfter": {
          "$ref": "#/$defs/bytes32"
        },
        "callData": {
          "$ref": "#/$defs/bytes"
        },
        "candidateValidAtObservation": {
          "type": "boolean"
        },
        "targetValidAtObservation": {
          "type": "boolean"
        }
      }
    },
    "routedObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "txOrigin",
        "executorEOAObserved",
        "executorEOAValid",
        "outerTarget",
        "outerCallData",
        "outerSuccess",
        "returnData",
        "timelock",
        "proxyAdmin",
        "operationId",
        "operationStateBefore",
        "operationStateBeforeObserved",
        "operationDoneBefore",
        "operationDoneAfter",
        "predecessor",
        "predecessorStateObserved",
        "predecessorDoneBefore",
        "observedTimestamp",
        "readyAt",
        "observedSlot",
        "implementationBefore",
        "implementationAfter",
        "proxyCodeObserved",
        "proxyHasCode",
        "candidateCodeObserved",
        "candidateHasCode",
        "proxyAdminOwnershipObserved",
        "proxyAdminOwnedByTimelock",
        "executorRolesObserved",
        "executorHasRole",
        "openExecutorRole"
      ],
      "properties": {
        "executor": {
          "$ref": "#/$defs/address"
        },
        "txOrigin": {
          "$ref": "#/$defs/address"
        },
        "executorEOAObserved": {
          "type": "boolean"
        },
        "executorEOAValid": {
          "type": "boolean"
        },
        "outerTarget": {
          "$ref": "#/$defs/address"
        },
        "outerCallData": {
          "$ref": "#/$defs/bytes"
        },
        "outerSuccess": {
          "type": "boolean"
        },
        "returnData": {
          "$ref": "#/$defs/bytes"
        },
        "timelock": {
          "$ref": "#/$defs/address"
        },
        "proxyAdmin": {
          "$ref": "#/$defs/address"
        },
        "operationId": {
          "$ref": "#/$defs/bytes32"
        },
        "operationStateBefore": {
          "enum": [
            "Unset",
            "Waiting",
            "Ready",
            "Done"
          ]
        },
        "operationStateBeforeObserved": {
          "type": "boolean"
        },
        "operationDoneBefore": {
          "type": "boolean"
        },
        "operationDoneAfter": {
          "type": "boolean"
        },
        "predecessor": {
          "$ref": "#/$defs/bytes32"
        },
        "predecessorStateObserved": {
          "type": "boolean"
        },
        "predecessorDoneBefore": {
          "type": "boolean"
        },
        "observedTimestamp": {
          "$ref": "#/$defs/uint256"
        },
        "readyAt": {
          "$ref": "#/$defs/uint256"
        },
        "observedSlot": {
          "$ref": "#/$defs/bytes32"
        },
        "implementationBefore": {
          "$ref": "#/$defs/bytes32"
        },
        "implementationAfter": {
          "$ref": "#/$defs/bytes32"
        },
        "proxyCodeObserved": {
          "type": "boolean"
        },
        "proxyHasCode": {
          "type": "boolean"
        },
        "candidateCodeObserved": {
          "type": "boolean"
        },
        "candidateHasCode": {
          "type": "boolean"
        },
        "proxyAdminOwnershipObserved": {
          "type": "boolean"
        },
        "proxyAdminOwnedByTimelock": {
          "type": "boolean"
        },
        "executorRolesObserved": {
          "type": "boolean"
        },
        "executorHasRole": {
          "type": "boolean"
        },
        "openExecutorRole": {
          "type": "boolean"
        }
      }
    },
    "directScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "spec",
        "derived"
      ],
      "properties": {
        "scenarioId": {
          "$ref": "#/$defs/bytes32"
        },
        "spec": {
          "$ref": "#/$defs/directSpec"
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonicalCalldata"
          ],
          "properties": {
            "canonicalCalldata": {
              "$ref": "#/$defs/bytes"
            }
          }
        }
      }
    },
    "routedScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "spec",
        "derived"
      ],
      "properties": {
        "scenarioId": {
          "$ref": "#/$defs/bytes32"
        },
        "spec": {
          "$ref": "#/$defs/routedSpec"
        },
        "derived": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "innerCalldata",
            "outerCalldata",
            "operationId"
          ],
          "properties": {
            "innerCalldata": {
              "$ref": "#/$defs/bytes"
            },
            "outerCalldata": {
              "$ref": "#/$defs/bytes"
            },
            "operationId": {
              "$ref": "#/$defs/bytes32"
            }
          }
        }
      }
    },
    "directStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedActiveImplementation",
        "observation",
        "evaluation"
      ],
      "properties": {
        "expectedActiveImplementation": {
          "$ref": "#/$defs/address"
        },
        "observation": {
          "$ref": "#/$defs/directObservation"
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN"
              ]
            },
            "reason": {
              "enum": [
                "NONE",
                "INVALID_SLOT",
                "CONTEXT_MISMATCH",
                "NON_CANONICAL_CALLDATA",
                "INVALID_CANDIDATE",
                "UNEXPECTED_REVERT",
                "SUCCESS_WITHOUT_REPLACEMENT",
                "INVALID_TARGET"
              ]
            }
          }
        }
      }
    },
    "routedStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedActiveImplementation",
        "observation",
        "evaluation"
      ],
      "properties": {
        "expectedActiveImplementation": {
          "$ref": "#/$defs/address"
        },
        "observation": {
          "$ref": "#/$defs/routedObservation"
        },
        "evaluation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL",
                "UNKNOWN"
              ]
            },
            "reason": {
              "enum": [
                "NONE",
                "CONTEXT_MISMATCH",
                "INCOMPLETE_EVIDENCE",
                "INCONSISTENT_TIMING",
                "INCONSISTENT_EXECUTION",
                "UNEXPECTED_REVERT",
                "EXECUTION_REJECTED",
                "MISSING_UPGRADE_EFFECT"
              ]
            }
          }
        }
      }
    },
    "directStages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/directStage"
        },
        "after": {
          "$ref": "#/$defs/directStage"
        }
      }
    },
    "routedStages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after"
      ],
      "properties": {
        "before": {
          "$ref": "#/$defs/routedStage"
        },
        "after": {
          "$ref": "#/$defs/routedStage"
        }
      }
    },
    "directComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioKey",
        "verdict",
        "reason"
      ],
      "properties": {
        "scenarioKey": {
          "$ref": "#/$defs/bytes32"
        },
        "verdict": {
          "enum": [
            "STILL_SATISFIED",
            "CHANGED_TO_VIOLATION",
            "CHANGED_TO_SATISFIED",
            "STILL_VIOLATED",
            "INDETERMINATE",
            "INCOMPARABLE"
          ]
        },
        "reason": {
          "enum": [
            "NONE",
            "SCENARIO_MISMATCH",
            "STAGE_BINDING_MISMATCH",
            "SAME_IMPLEMENTATION_STAGE",
            "INDETERMINATE_POLICY"
          ]
        }
      }
    },
    "routedComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioKey",
        "verdict",
        "reason"
      ],
      "properties": {
        "scenarioKey": {
          "$ref": "#/$defs/bytes32"
        },
        "verdict": {
          "enum": [
            "STILL_SATISFIED",
            "CHANGED_TO_VIOLATION",
            "CHANGED_TO_SATISFIED",
            "STILL_VIOLATED",
            "INDETERMINATE",
            "INCOMPARABLE"
          ]
        },
        "reason": {
          "enum": [
            "NONE",
            "SCENARIO_MISMATCH",
            "STAGE_BINDING_MISMATCH",
            "SAME_IMPLEMENTATION_STAGE",
            "PREPARATION_MISMATCH",
            "INDETERMINATE_POLICY"
          ]
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixtureId",
        "executionMode",
        "chainId",
        "forgeVersion",
        "solcVersion",
        "dependencyRevisions"
      ],
      "properties": {
        "fixtureId": {
          "type": "string",
          "minLength": 1
        },
        "executionMode": {
          "enum": [
            "local_fixture",
            "fork"
          ]
        },
        "chainId": {
          "$ref": "#/$defs/uint256"
        },
        "forgeVersion": {
          "type": "string",
          "minLength": 1
        },
        "solcVersion": {
          "type": "string",
          "minLength": 1
        },
        "dependencyRevisions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "openzeppelinContracts",
            "openzeppelinContractsUpgradeable"
          ],
          "properties": {
            "openzeppelinContracts": {
              "$ref": "#/$defs/sha"
            },
            "openzeppelinContractsUpgradeable": {
              "$ref": "#/$defs/sha"
            }
          }
        },
        "fork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "blockNumber",
            "blockHash"
          ],
          "properties": {
            "blockNumber": {
              "$ref": "#/$defs/uint256"
            },
            "blockHash": {
              "$ref": "#/$defs/bytes32"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "executionMode": {
                "const": "fork"
              }
            },
            "required": [
              "executionMode"
            ]
          },
          "then": {
            "required": [
              "fork"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "executionMode": {
                "const": "local_fixture"
              }
            },
            "required": [
              "executionMode"
            ]
          },
          "then": {
            "not": {
              "required": [
                "fork"
              ]
            }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sourceCommit",
        "workingTreeClean",
        "runId",
        "sourceInputs",
        "reproduceCommand"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "sourceCommit": {
          "$ref": "#/$defs/sha"
        },
        "workingTreeClean": {
          "type": "boolean"
        },
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "sourceInputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        "reproduceCommand": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": [
        "route",
        "semantics_version",
        "scenario",
        "stages",
        "comparison"
      ],
      "properties": {
        "route": {
          "const": "DIRECT_EOA_UUPS"
        },
        "semantics_version": {
          "const": "direct-eoa-v1"
        },
        "scenario": {
          "$ref": "#/$defs/directScenario"
        },
        "stages": {
          "$ref": "#/$defs/directStages"
        },
        "comparison": {
          "$ref": "#/$defs/directComparison"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "route",
        "semantics_version",
        "scenario",
        "stages",
        "comparison"
      ],
      "properties": {
        "route": {
          "const": "OZ_TIMELOCK_SINGLE"
        },
        "semantics_version": {
          "const": "oz-timelock-single-v1"
        },
        "scenario": {
          "$ref": "#/$defs/routedScenario"
        },
        "stages": {
          "$ref": "#/$defs/routedStages"
        },
        "comparison": {
          "$ref": "#/$defs/routedComparison"
        }
      }
    }
  ]
}
